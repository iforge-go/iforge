# ============================================================
# iForge 环境变量配置示例
# 用法：复制此文件为 .env，按需修改后再启动
#   cp .env.example .env
# ============================================================

# ---------- 后端（api） ----------

# 数据目录：数据库文件、日志、Git 仓库存储都在此目录下
# Docker 部署时会挂载为数据卷，便于持久化
IFORGE_HOME=./data

# HTTP 服务端口（浏览器与 Git HTTP 协议都走此端口）
IFORGE_HTTP_PORT=8081

# 会话密钥：用于签发 JWT/Session Cookie
# - 留空：首次启动自动生成 32 字节随机密钥并持久化到数据库，
#   重启复用同一密钥，不影响登录态（单机/单容器部署推荐）
# - 多副本部署（K8s 多 Pod、多容器）必须设置为固定值，否则各副本密钥不一致
IFORGE_SESSION_SECRET=

# SSH Git 服务（git@host:repo 形式的克隆/推送）
IFORGE_SSH_ENABLED=true
IFORGE_SSH_PORT=2022

# ---------- 前端（web） ----------

# 后端 API 基础地址（浏览器可访问的地址）
# - 留空（推荐）：前端运行时按浏览器 hostname 自动适配，局域网/公网均可用
# - 固定值：如 https://your-domain.com/api/v1（需与实际访问地址一致）
NEXT_PUBLIC_API_BASE=

# CORS 允许的前端来源（后端用）
# - *：反射任意 Origin（自托管/局域网部署推荐，兼容 cookie credentials）
# - 具体值：http://192.168.1.100:3001（多个用逗号分隔，更严格）
IFORGE_CORS_ORIGINS=*

# ---------- Database connection pool ----------
# Per-server limits for MySQL/PostgreSQL. SQLite always uses one connection.
IFORGE_DB_MAX_IDLE_CONNS=10
IFORGE_DB_MAX_OPEN_CONNS=30
# Recycle long-lived connections before common load balancer/database timeouts.
IFORGE_DB_CONN_MAX_LIFETIME_SECONDS=1800
IFORGE_DB_CONN_MAX_IDLE_TIME_SECONDS=300

# 禁用内置 CI/CD 执行器（true = 所有 job 由外置 runner 处理）
# 使用外置 runner 时设为 true，避免内置执行器（alpine 容器无 bash/docker-cli）抢 job
IFORGE_DISABLE_BUILTIN_EXECUTOR=false

# ---------- 文档站（docs） ----------

# 文档站端口（Docusaurus 静态站点）
IFORGE_DOCS_PORT=3002
